# App
NODE_ENV=development
PORT=5300
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# Docker (host ports)
POSTGRES_USER=chantieros
POSTGRES_PASSWORD=chantieros_pass
POSTGRES_DB=chantieros
POSTGRES_PORT=5440
REDIS_PORT=6390

# Database (Prisma)
DATABASE_URL=postgresql://chantieros:chantieros_pass@127.0.0.1:5440/chantieros?schema=public

# Redis (BullMQ, Socket.io) - not used yet
REDIS_URL=redis://127.0.0.1:6390

# JWT - not used yet (change these!)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Prisma logs: leave empty for warnings only, or set to "query" to see SQL
PRISMA_LOG=

# Stripe (use test keys: sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_PUBLISHABLE_KEY=pk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me

# ImageKit (dashboard.imagekit.io > Developer > API keys)
IMAGEKIT_PUBLIC_KEY=public_change-me
IMAGEKIT_PRIVATE_KEY=private_change-me
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Super-admin created by `yarn seed:admin` (dev only, password min 12 chars)
SEED_ADMIN_EMAIL=admin@chantieros.local
SEED_ADMIN_PASSWORD=change-me-min-12-chars

# Resend (resend.com > API Keys). EMAIL = sender address, its domain must be verified in Resend
RESEND_API_KEY=re_change-me
EMAIL=no-reply@your-domain.com

# Telegram bot (telegram-bot.js)
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=0
