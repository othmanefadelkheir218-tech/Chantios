// ChantierOS — Prisma schema
//
// Generated from doc/Schema Proposal.md, which is generated from doc/notes/*.md.
// If this file and a note disagree, the NOTE wins — fix this file.
//
// Rules (doc/Schema Proposal.md § Design rules):
//  1. tenant_id NOT NULL on every business table. Only 8 platform tables are exempt.
//     categories + cost_types have a NULLABLE tenant_id: NULL = shared default.
//  2. No table stores a running total. The exception is a document total on
//     quotes/invoices, because a sent paper must never change.
//  3. Prices are frozen on the row that uses them: stock_movements.unit_price,
//     time_entries.hourly_rate.
//  4. Every status is an enum.
//  5. Unique constraints are composite with tenant_id.
//  6. Nothing secret is readable: *_hash columns only.
//  7. money Decimal(12,2) · quantity Decimal(12,3) · recipe Decimal(12,4)
//     hours Decimal(5,2) · rate Decimal(5,2) · progress_pct Int

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  active
  suspended
  banned

  @@map("tenant_status")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled

  @@map("subscription_status")
}

enum ClientType {
  individual
  professional
  property_manager

  @@map("client_type")
}

enum ProjectStatus {
  prospect
  in_progress
  completed
  cancelled

  @@map("project_status")
}

enum QuoteStatus {
  draft
  sent
  accepted
  refused

  @@map("quote_status")
}

/// No `overdue`. Late is calculated: due_date < today AND balance_due > 0.
enum InvoiceStatus {
  draft
  sent
  partially_paid
  paid
  cancelled

  @@map("invoice_status")
}

enum PaymentMethod {
  transfer
  cheque
  cash
  stripe

  @@map("payment_method")
}

enum PurchaseInvoiceStatus {
  to_pay
  paid

  @@map("purchase_invoice_status")
}

enum PurchaseInvoiceType {
  subcontractor
  supplier

  @@map("purchase_invoice_type")
}

enum ContractStatus {
  in_progress
  completed
  cancelled

  @@map("contract_status")
}

enum StockMovementType {
  purchase
  consumption
  adjustment

  @@map("stock_movement_type")
}

enum ReservationStatus {
  active
  released
  consumed

  @@map("reservation_status")
}

enum TaskType {
  meeting
  work

  @@map("task_type")
}

enum TaskStatus {
  planned
  in_progress
  completed

  @@map("task_status")
}

enum ConversationType {
  internal
  project_client
  support

  @@map("conversation_type")
}

enum SenderType {
  employee
  client
  admin

  @@map("sender_type")
}

enum PortalEventType {
  view
  download

  @@map("portal_event_type")
}

enum DocumentType {
  quote
  invoice
  purchase_invoice

  @@map("document_type")
}

enum OneTimeCodeType {
  password_reset
  email_verification
  admin_2fa

  @@map("one_time_code_type")
}

enum MarginAlertLevel {
  warning
  critical

  @@map("margin_alert_level")
}

/// `own` = only the current user's own rows. The default matrix has three
/// levels (full / view / own) and four booleans cannot express the third.
enum PermissionScope {
  all
  own

  @@map("permission_scope")
}

enum TicketStatus {
  open
  in_progress
  waiting_tenant
  closed

  @@map("ticket_status")
}

enum TicketCategory {
  bug
  question
  billing
  other

  @@map("ticket_category")
}

enum TicketPriority {
  low
  normal
  high

  @@map("ticket_priority")
}

enum FeedbackType {
  feature_request
  improvement
  complaint

  @@map("feedback_type")
}

enum FeedbackStatus {
  new
  reviewing
  planned
  declined
  shipped

  @@map("feedback_status")
}

enum PermissionModule {
  clients
  projects
  tasks
  time_entries
  catalogue
  stock
  quotes
  invoices
  purchase_invoices
  margins
  subcontractors
  reports
  media
  chat
  team
  settings

  @@map("permission_module")
}

enum MediaEntityType {
  user
  tenant
  project
  report
  purchase_invoice
  quote
  invoice
  message

  @@map("media_entity_type")
}

// ============================================================================
// 1. PLATFORM
// ============================================================================

model Tenant {
  id                   Int          @id @default(autoincrement())
  name                 String
  legalName            String?      @map("legal_name")
  vatNumber            String?      @map("vat_number")
  registrationNumber   String?      @map("registration_number")
  email                String       @unique
  phone                String?
  addressLine1         String?      @map("address_line1")
  addressLine2         String?      @map("address_line2")
  postalCode           String?      @map("postal_code")
  city                 String?
  country              String?      @db.Char(2)
  /// → media.id. No FK: media is polymorphic.
  logoMediaId          Int?         @map("logo_media_id")
  defaultVatRate       Decimal      @default(21.00) @map("default_vat_rate") @db.Decimal(5, 2)
  /// Fills invoices.due_date as issue_date + this many days.
  defaultPaymentDays   Int          @default(30) @map("default_payment_days") @db.SmallInt
  locale               String       @default("fr")
  currency             String       @default("EUR") @db.Char(3)
  timezone             String       @default("Europe/Brussels")
  endOfDayReminderTime DateTime     @default(dbgenerated("'18:00:00'::time without time zone")) @map("end_of_day_reminder_time") @db.Time(6)
  status               TenantStatus @default(active)
  /// Soft delete. NULL = not deleted. Independent of `status`.
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)
  /// NULL = not verified. Not required at creation.
  emailVerifiedAt      DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                User[]
  rolePermissions      RolePermission[]
  invitations          UserInvitation[]
  oneTimeCodes         OneTimeCode[]
  subscription         TenantSubscription?
  usageSnapshots       BillingUsageSnapshot[]
  auditLogs            AuditLog[]
  analyticsEvents      AnalyticsEvent[]
  feedback             Feedback[]
  supportTickets       SupportTicket[]
  clients              Client[]
  projects             Project[]
  projectStatusHistory ProjectStatusHistory[]
  categories           Category[]
  services             Service[]
  materials            Material[]
  serviceMaterials     ServiceMaterial[]
  stockMovements       StockMovement[]
  stockReservations    StockReservation[]
  tasks                Task[]
  taskAssignees        TaskAssignee[]
  timeEntries          TimeEntry[]
  reports              Report[]
  documentCounters     DocumentCounter[]
  quotes               Quote[]
  quoteLines           QuoteLine[]
  invoices             Invoice[]
  invoiceLines         InvoiceLine[]
  payments             Payment[]
  subcontractors       Subcontractor[]
  suppliers            Supplier[]
  contracts            SubcontractorContract[]
  costTypes            CostType[]
  purchaseInvoices     PurchaseInvoice[]
  closureSnapshots     ProjectClosureSnapshot[]
  closureSnapshotCosts ProjectClosureSnapshotCost[]
  marginAlerts         ProjectMarginAlert[]
  media                Media[]
  notifications        Notification[]
  portalTokens         PortalToken[]
  portalTracking       PortalTracking[]
  conversations        Conversation[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  messageReads         MessageRead[]

  @@map("tenants")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  /// argon2id
  passwordHash String   @map("password_hash")
  /// otplib TOTP secret, for the admin_2fa challenge
  totpSecret   String?  @map("totp_secret")
  /// 'super_admin' | 'staff'
  role         String   @default("staff")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens       RefreshToken[]
  oneTimeCodes        OneTimeCode[]
  auditLogs           AuditLog[]
  assignedTickets     SupportTicket[]
  notifications       Notification[]
  conversationMembers ConversationMember[]

  @@map("admin_users")
}

/// Immutable once in use: a price or limit change deactivates the row and
/// creates a new one with parentPlanId set. Existing tenants keep their plan_id.
/// Plans are NEVER seeded — the super-admin creates them as data, and one must
/// carry isDefault = true before a company can register.
model Plan {
  id            Int      @id @default(autoincrement())
  name          String
  basePrice     Decimal  @map("base_price") @db.Decimal(12, 2)
  isActive      Boolean  @default(true) @map("is_active")
  /// The plan a new signup lands on. A partial unique index allows only one.
  isDefault     Boolean  @default(false) @map("is_default")
  parentPlanId  Int?     @map("parent_plan_id")
  stripePriceId String?  @map("stripe_price_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parentPlan    Plan?                @relation("PlanVersions", fields: [parentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions      Plan[]               @relation("PlanVersions")
  features      PlanFeature[]
  subscriptions TenantSubscription[] @relation("CurrentPlan")
  pendingFor    TenantSubscription[] @relation("PendingPlan")

  @@map("plans")
}

model PlanFeature {
  id          Int     @id @default(autoincrement())
  planId      Int     @map("plan_id")
  /// max_workers | max_managers | max_clients | max_subcontractors | storage_gb | retention_days
  featureKey  String  @map("feature_key")
  limitValue  Int     @map("limit_value")
  /// retention_days has no overage
  overageRate Decimal @default(0) @map("overage_rate") @db.Decimal(12, 2)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_features")
}

/// One row per tenant. There is NO `subscriptions` table.
/// Created in the SAME transaction as the tenant at registration:
/// the isDefault plan, status = trialing, periodEnd = now + 14 days.
/// SubscriptionGuard allows trialing/active/past_due, blocks cancelled.
/// It never counts resources — overage is billed, never blocked.
model TenantSubscription {
  id                     Int                @id @default(autoincrement())
  tenantId               Int                @unique @map("tenant_id")
  planId                 Int                @map("plan_id")
  stripeCustomerId       String?            @map("stripe_customer_id")
  stripeSubscriptionId   String?            @map("stripe_subscription_id")
  stripePriceId          String?            @map("stripe_price_id")
  status                 SubscriptionStatus @default(trialing)
  periodStart            DateTime           @default(now()) @map("period_start") @db.Timestamptz(6)
  periodEnd              DateTime           @map("period_end") @db.Timestamptz(6)
  pendingPlanId          Int?               @map("pending_plan_id")
  pendingPlanEffectiveAt DateTime?          @map("pending_plan_effective_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan   @relation("CurrentPlan", fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pendingPlan Plan?  @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tenant_subscriptions")
}

/// Limits and rates are COPIED here at snapshot time, so a later plan change
/// never shifts a historical invoice.
model BillingUsageSnapshot {
  id                Int      @id @default(autoincrement())
  tenantId          Int      @map("tenant_id")
  periodStart       DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd         DateTime @map("period_end") @db.Timestamptz(6)
  snapshotTakenAt   DateTime @default(now()) @map("snapshot_taken_at") @db.Timestamptz(6)
  featureKey        String   @map("feature_key")
  actualCount       Decimal  @map("actual_count") @db.Decimal(14, 3)
  includedAllowance Int      @map("included_allowance")
  overageRate       Decimal  @map("overage_rate") @db.Decimal(12, 2)
  /// max(0, actual - allowance) * rate
  overageAmount     Decimal  @map("overage_amount") @db.Decimal(12, 2)
  stripeInvoiceId   String?  @map("stripe_invoice_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, featureKey])
  @@map("billing_usage_snapshots")
}

/// Never process a webhook with the same stripeEventId twice.
model StripeEvent {
  id            Int       @id @default(autoincrement())
  stripeEventId String    @unique @map("stripe_event_id")
  type          String
  payload       Json
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  error         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stripe_events")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tenantId    Int?     @map("tenant_id")
  adminUserId Int?     @map("admin_user_id")
  /// Tenant-side actor. No FK: history outlives the user row.
  userId      Int?     @map("user_id")
  /// 'update' | 'delete' | 'impersonate_enter' | 'impersonate_exit' | ...
  action      String
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Append-only. Written as a side effect through BullMQ, never blocking a request.
/// retention_days deletes rows here — and read notifications — and nothing else.
model AnalyticsEvent {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  userId    Int?     @map("user_id")
  eventName String   @map("event_name")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("analytics_events")
}

/// One-way: the tenant posts, the platform changes the status. Not a conversation.
model Feedback {
  id          Int            @id @default(autoincrement())
  tenantId    Int            @map("tenant_id")
  submittedBy Int            @map("submitted_by")
  type        FeedbackType
  title       String
  body        String?
  status      FeedbackStatus @default(new)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submitter User   @relation(fields: [submittedBy], references: [id], onDelete: Restrict)

  @@map("feedback")
}

/// A container. All the talking happens in a `support` Conversation.
model SupportTicket {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  /// Must hold the `admin` role — checked in the handler.
  openedBy        Int            @map("opened_by")
  subject         String
  category        TicketCategory @default(question)
  priority        TicketPriority @default(normal)
  status          TicketStatus   @default(open)
  assignedAdminId Int?           @map("assigned_admin_id")
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opener        User           @relation(fields: [openedBy], references: [id], onDelete: Restrict)
  assignedAdmin AdminUser?     @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)
  conversations Conversation[]

  @@index([tenantId, status])
  @@map("support_tickets")
}

// ============================================================================
// 2. AUTH & USERS
// ============================================================================

/// 7 rows, seeded on first deploy. SMALLINT ids 1-7, NOT uuid.
model Role {
  id       Int     @id @db.SmallInt
  name     String  @unique
  label    String
  isActive Boolean @default(true) @map("is_active")

  users           User[]
  rolePermissions RolePermission[]
  invitations     UserInvitation[]

  @@map("roles")
}

/// email is UNIQUE ACROSS THE WHOLE APP, not per tenant, because login is
/// email + password with no company field. One email belongs to one company.
model User {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  roleId          Int       @map("role_id") @db.SmallInt
  name            String
  email           String    @unique
  phone           String?
  /// argon2id
  passwordHash    String?   @map("password_hash")
  /// argon2id. `worker` role only — a PIN is a credential, never readable.
  mobilePinHash   String?   @map("mobile_pin_hash")
  /// Locks the account at 5.
  failedPinCount  Int       @default(0) @map("failed_pin_count") @db.SmallInt
  /// Frozen onto each time_entries row at write time.
  hourlyRate      Decimal   @default(0) @map("hourly_rate") @db.Decimal(12, 2)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refreshTokens       RefreshToken[]
  oneTimeCodes        OneTimeCode[]
  sentInvitations     UserInvitation[]         @relation("InvitedBy")
  analyticsEvents     AnalyticsEvent[]
  feedback            Feedback[]
  openedTickets       SupportTicket[]
  managedProjects     Project[]                @relation("ProjectManager")
  createdProjects     Project[]                @relation("ProjectCreatedBy")
  statusChanges       ProjectStatusHistory[]
  stockMovements      StockMovement[]
  createdTasks        Task[]
  taskAssignees       TaskAssignee[]
  timeEntries         TimeEntry[]              @relation("TimeEntryUser")
  createdTimeEntries  TimeEntry[]              @relation("TimeEntryCreatedBy")
  reports             Report[]
  createdQuotes       Quote[]
  createdInvoices     Invoice[]
  createdPayments     Payment[]
  createdContracts    SubcontractorContract[]
  createdPurchaseInv  PurchaseInvoice[]
  closedSnapshots     ProjectClosureSnapshot[] @relation("SnapshotClosedBy")
  voidedSnapshots     ProjectClosureSnapshot[] @relation("SnapshotVoidedBy")
  uploadedMedia       Media[]
  notifications       Notification[]
  createdPortalTokens PortalToken[]
  conversationMembers ConversationMember[]
  messageReads        MessageRead[]

  @@index([tenantId])
  @@map("users")
}

/// OVERRIDES ONLY. The default matrix lives in code, nothing is seeded per
/// tenant. PermissionGuard reads the code default, then applies a row here.
///
/// `scope` is why this table needs 5 columns, not 4: the default matrix has
/// three levels (full / view / own). `own` means "yes, but only their own
/// rows" — a worker sees their own tasks and hours. Four booleans cannot say
/// that. On scope = own, PermissionGuard adds WHERE user_id = :current.
model RolePermission {
  id        Int              @id @default(autoincrement())
  tenantId  Int              @map("tenant_id")
  roleId    Int              @map("role_id") @db.SmallInt
  module    PermissionModule
  canView   Boolean          @default(false) @map("can_view")
  canCreate Boolean          @default(false) @map("can_create")
  canEdit   Boolean          @default(false) @map("can_edit")
  canDelete Boolean          @default(false) @map("can_delete")
  scope     PermissionScope  @default(all)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, roleId, module])
  @@map("role_permissions")
}

/// The access token (15 min) is stateless and never stored. The refresh token
/// (7 days) is stored HASHED so a session can be killed.
/// Exactly one of userId / adminUserId is set — enforced by a CHECK.
/// Every refresh rotates: new row, old revoked. A revoked token used again
/// means it was stolen — revoke every row for that user.
model RefreshToken {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  adminUserId Int?      @map("admin_user_id")
  /// sha256. The raw value lives only in the cookie.
  tokenHash   String    @unique @map("token_hash")
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// An employee never registers — the admin invites them. The users row is
/// created when the invitation is ACCEPTED, not when it is sent.
/// One open invitation per email app-wide, same reason as users.email.
model UserInvitation {
  id         Int       @id @default(autoincrement())
  tenantId   Int       @map("tenant_id")
  email      String
  name       String
  roleId     Int       @map("role_id") @db.SmallInt
  /// sha256. The raw token is only in the email link.
  tokenHash  String    @unique @map("token_hash")
  invitedBy  Int       @map("invited_by")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviter User   @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@map("user_invitations")
}

/// One table for every short-lived code, split by `type`. The fields are
/// identical, so three tables would be waste.
///   password_reset     1 hour    max 5 attempts
///   email_verification 24 hours  —
///   admin_2fa          5 minutes max 3 attempts
model OneTimeCode {
  id           Int             @id @default(autoincrement())
  /// Exactly one of tenantId / userId / adminUserId is set per row.
  tenantId     Int?            @map("tenant_id")
  userId       Int?            @map("user_id")
  adminUserId  Int?            @map("admin_user_id")
  type         OneTimeCodeType
  /// sha256
  codeHash     String          @map("code_hash")
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?       @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int             @default(0) @map("attempt_count") @db.SmallInt
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("one_time_codes")
}

// ============================================================================
// 3. CLIENTS & PROJECTS
// ============================================================================

/// email is required: the whole client flow is email (quote sent, invoice
/// sent, late reminder, portal link). UNIQUE per tenant — one card per person,
/// so a client's whole project history stays on one row.
model Client {
  id             Int        @id @default(autoincrement())
  tenantId       Int        @map("tenant_id")
  type           ClientType @default(individual)
  name           String
  contactName    String?    @map("contact_name")
  email          String
  phone          String
  phoneSecondary String?    @map("phone_secondary")
  /// Required when type = professional — enforced by a CHECK.
  vatNumber      String?    @map("vat_number")
  addressLine1   String?    @map("address_line1")
  addressLine2   String?    @map("address_line2")
  postalCode     String?    @map("postal_code")
  city           String?
  country        String?    @db.Char(2)
  /// Internal free text. NEVER shown in the portal.
  note           String?
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects            Project[]
  quotes              Quote[]
  invoices            Invoice[]
  portalTokens        PortalToken[]
  conversationMembers ConversationMember[]
  messageReads        MessageRead[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("clients")
}

/// Deliberately has NO budget and NO progress column.
///   budget   = SUM(quotes.amount_excl_vat) WHERE status = accepted, in the view
///   progress = progress_pct of the newest reports row
/// Transitions (enforced in the service):
///   prospect    -> in_progress, cancelled
///   in_progress -> completed, cancelled
///   completed   -> in_progress  (admin only — VOIDS the closure snapshot)
///   cancelled   -> nothing      (final)
model Project {
  id            Int           @id @default(autoincrement())
  tenantId      Int           @map("tenant_id")
  clientId      Int           @map("client_id")
  name          String
  description   String?
  status        ProjectStatus @default(prospect)
  addressLine1  String?       @map("address_line1")
  addressLine2  String?       @map("address_line2")
  postalCode    String?       @map("postal_code")
  city          String?
  startDate     DateTime?     @map("start_date") @db.Date
  /// CHECK: not before startDate
  endDate       DateTime?     @map("end_date") @db.Date
  /// Set when status becomes completed.
  actualEndDate DateTime?     @map("actual_end_date") @db.Date
  managerId     Int?          @map("manager_id")
  createdBy     Int?          @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  manager User?  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  creator User?  @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  statusHistory     ProjectStatusHistory[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  tasks             Task[]
  timeEntries       TimeEntry[]
  reports           Report[]
  quotes            Quote[]
  invoices          Invoice[]
  contracts         SubcontractorContract[]
  purchaseInvoices  PurchaseInvoice[]
  closureSnapshots  ProjectClosureSnapshot[]
  marginAlerts      ProjectMarginAlert[]
  portalTokens      PortalToken[]
  conversations     Conversation[]

  @@index([tenantId, status])
  @@map("projects")
}

model ProjectStatusHistory {
  id         Int            @id @default(autoincrement())
  tenantId   Int            @map("tenant_id")
  projectId  Int            @map("project_id")
  /// NULL on creation
  fromStatus ProjectStatus? @map("from_status")
  toStatus   ProjectStatus  @map("to_status")
  reason     String?
  changedBy  Int?           @map("changed_by")
  changedAt  DateTime       @default(now()) @map("changed_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changer User?   @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([projectId, changedAt])
  @@map("project_status_history")
}

// ============================================================================
// 4. CATALOGUE & STOCK
// ============================================================================

/// tenantId is NULLABLE: NULL = a shared default, seeded at deploy. That is
/// what makes a deploy-time seed possible — a seed has no company to belong to.
/// MUST be read with: WHERE tenant_id IS NULL OR tenant_id = :current
/// through a dedicated method, never the generic tenant filter.
model Category {
  id        Int      @id @default(autoincrement())
  tenantId  Int?     @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("categories")
}

model Service {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  categoryId     Int      @map("category_id")
  description    String
  /// m2 | ml | h | piece
  unit           String
  priceExclVat   Decimal  @map("price_excl_vat") @db.Decimal(12, 2)
  /// NULL falls back to tenants.default_vat_rate. Set 6.00 on Belgian labour
  /// services so the quote line pre-fills the right rate by itself.
  defaultVatRate Decimal? @map("default_vat_rate") @db.Decimal(5, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipe       ServiceMaterial[]
  quoteLines   QuoteLine[]
  invoiceLines InvoiceLine[]

  @@index([tenantId])
  @@map("services")
}

/// Has NO quantity column. The quantity in stock is never stored — it is
/// always summed from the stock_movements ledger via material_stock_live.
model Material {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  description   String
  unit          String
  /// Today's price. The frozen one sits on each movement.
  purchasePrice Decimal  @default(0) @map("purchase_price") @db.Decimal(12, 2)
  minimumStock  Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeRows   ServiceMaterial[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@index([tenantId])
  @@map("materials")
}

/// The recipe: how much of a material one unit of a service consumes.
model ServiceMaterial {
  id              Int     @id @default(autoincrement())
  tenantId        Int     @map("tenant_id")
  serviceId       Int     @map("service_id")
  materialId      Int     @map("material_id")
  quantityPerUnit Decimal @map("quantity_per_unit") @db.Decimal(12, 4)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([serviceId, materialId])
  @@map("service_materials")
}

/// The ONE source of truth for quantity. Append-only: a mistake is corrected
/// with a new `adjustment` row, never by editing or deleting.
///
/// CHECKs:
///   consumption -> projectId NOT NULL AND quantity < 0
///   purchase    -> projectId IS NULL   AND quantity > 0
model StockMovement {
  id                Int               @id @default(autoincrement())
  tenantId          Int               @map("tenant_id")
  materialId        Int               @map("material_id")
  /// Required on consumption, always NULL on purchase — stock is a shared pool.
  projectId         Int?              @map("project_id")
  /// The site report that declared this consumption. Traceability.
  reportId          Int?              @map("report_id")
  /// The supplier bill, when both exist. Either can exist alone.
  purchaseInvoiceId Int?              @map("purchase_invoice_id")
  type              StockMovementType
  /// SIGNED: + purchase, - consumption, either sign for adjustment. Never zero.
  quantity          Decimal           @db.Decimal(12, 3)
  /// FROZEN from materials.purchase_price at this moment. A price change next
  /// month never shifts a past cost.
  unitPrice         Decimal           @map("unit_price") @db.Decimal(12, 2)
  movementDate      DateTime          @default(dbgenerated("CURRENT_DATE")) @map("movement_date") @db.Date
  /// Why. Required on an adjustment.
  note              String?
  createdBy         Int?              @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  material        Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  report          Report?          @relation(fields: [reportId], references: [id], onDelete: SetNull)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  creator         User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, materialId])
  @@index([projectId])
  @@map("stock_movements")
}

/// TWO quantity columns on purpose. reservedQuantity is what the accepted
/// quotes asked for; remainingQuantity is what is still held. Consuming
/// material lowers remainingQuantity ONLY, so the original is never lost.
/// UNIQUE(projectId, materialId): a second accepted quote ADDS to this row.
/// Only `active` rows count in material_stock_live.reserved.
model StockReservation {
  id                Int               @id @default(autoincrement())
  tenantId          Int               @map("tenant_id")
  projectId         Int               @map("project_id")
  materialId        Int               @map("material_id")
  reservedQuantity  Decimal           @map("reserved_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal           @map("remaining_quantity") @db.Decimal(12, 3)
  status            ReservationStatus @default(active)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([projectId, materialId])
  @@map("stock_reservations")
}

// ============================================================================
// 5. PLANNING, TIME & SITE REPORTS
// ============================================================================

model Task {
  id        Int        @id @default(autoincrement())
  tenantId  Int        @map("tenant_id")
  projectId Int        @map("project_id")
  title     String
  type      TaskType   @default(work)
  startDate DateTime   @map("start_date") @db.Date
  /// CHECK: not before startDate
  endDate   DateTime   @map("end_date") @db.Date
  status    TaskStatus @default(planned)
  createdBy Int?       @map("created_by")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  timeEntries TimeEntry[]

  @@unique([tenantId, id])
  @@index([projectId])
  @@map("tasks")
}

/// One row per employee on a task. A demolition task with five workers is ONE
/// task row and five assignee rows — one bar on the Gantt chart, not five.
/// userId is a REAL account, never a typed name, because that account logs the
/// hours later. A task needs >= 1 assignee before leaving `planned`.
model TaskAssignee {
  id       Int @id @default(autoincrement())
  tenantId Int @map("tenant_id")
  taskId   Int @map("task_id")
  userId   Int @map("user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite FK: the assignee row and its task MUST belong to the same company.
  task   Task   @relation(fields: [tenantId, taskId], references: [tenantId, id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// NOT append-only: an hour entry has one right answer per employee per day
/// per project, so the row is corrected and the old value goes to audit_logs.
///
/// The daily rule (service layer): sum ALL rows for that user + work_date
/// across EVERY project.  <=12h saved · >12h saved + alert · >24h REJECTED.
/// A per-row check is not enough: 20h on A + 20h on B both pass it.
model TimeEntry {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  projectId  Int      @map("project_id")
  userId     Int      @map("user_id")
  taskId     Int?     @map("task_id")
  workDate   DateTime @map("work_date") @db.Date
  /// CHECK: > 0 AND <= 24
  hours      Decimal  @db.Decimal(5, 2)
  /// FROZEN from users.hourly_rate at write time, so past margins never shift.
  hourlyRate Decimal  @map("hourly_rate") @db.Decimal(12, 2)
  comment    String?
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user    User    @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  creator User?   @relation("TimeEntryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([userId, projectId, workDate])
  @@index([userId, workDate])
  @@index([projectId])
  @@map("time_entries")
}

/// One row per project per day. Re-posting the same day EDITS this row.
/// Feeds three things: the portal progress %, the stock consumption rows,
/// and the report photos (media, entity_type = report).
model Report {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  projectId   Int      @map("project_id")
  reportDate  DateTime @default(dbgenerated("CURRENT_DATE")) @map("report_date") @db.Date
  /// CHECK: 0..100
  progressPct Int      @map("progress_pct")
  weather     String?
  note        String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator   User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@unique([tenantId, projectId, reportDate])
  @@map("reports")
}

// ============================================================================
// 6. CLIENT MONEY — QUOTES, INVOICES, PAYMENTS
// ============================================================================

/// PK (tenantId, documentType, year). The row lock is what stops two
/// simultaneous clicks taking the same number:
///   INSERT ... ON CONFLICT DO UPDATE SET last_number = last_number + 1 RETURNING
/// inside the document's OWN transaction. Never COUNT(*) + 1.
model DocumentCounter {
  tenantId     Int          @map("tenant_id")
  documentType DocumentType @map("document_type")
  year         Int          @db.SmallInt
  lastNumber   Int          @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, documentType, year])
  @@map("document_counters")
}

/// VAT lives on the LINE, not here. A Belgian document mixes 6% labour and
/// 21% supplies, and one column cannot hold two rates. defaultVatRate is only
/// the pre-fill for a new line.
///
/// The three totals are STORED. While draft the service recalculates them on
/// every line change; on `sent`, lines and totals freeze together.
/// VAT is rounded ONCE PER RATE GROUP, never per line then summed.
///
/// acceptedAt is what makes budget history free: the accepted quotes with
/// their dates ARE the history. No project_budget_history table.
model Quote {
  id             Int         @id @default(autoincrement())
  tenantId       Int         @map("tenant_id")
  clientId       Int         @map("client_id")
  projectId      Int         @map("project_id")
  /// QUO-2026-0001
  number         String
  status         QuoteStatus @default(draft)
  issueDate      DateTime    @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  validUntil     DateTime?   @map("valid_until") @db.Date
  /// Pre-fill for new lines, copied from tenants.default_vat_rate.
  defaultVatRate Decimal     @map("default_vat_rate") @db.Decimal(5, 2)
  amountExclVat  Decimal     @default(0) @map("amount_excl_vat") @db.Decimal(12, 2)
  vatAmount      Decimal     @default(0) @map("vat_amount") @db.Decimal(12, 2)
  amountInclVat  Decimal     @default(0) @map("amount_incl_vat") @db.Decimal(12, 2)
  note           String?
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(6)
  acceptedAt     DateTime?   @map("accepted_at") @db.Timestamptz(6)
  refusedAt      DateTime?   @map("refused_at") @db.Timestamptz(6)
  createdBy      Int?        @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator  User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  lines    QuoteLine[]
  invoices Invoice[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([projectId, status])
  @@map("quotes")
}

/// serviceId is NULLABLE on purpose: a catalogue line reserves stock through
/// the recipe, a free-text line reserves nothing. Staff must be able to write
/// a free line.
/// totalExclVat is DB-COMPUTED — that is what fixes the NaN total bug.
/// The composite FK (tenantId, quoteId) makes a cross-tenant line impossible.
model QuoteLine {
  id               Int     @id @default(autoincrement())
  tenantId         Int     @map("tenant_id")
  quoteId          Int     @map("quote_id")
  serviceId        Int?    @map("service_id")
  description      String
  unit             String?
  /// CHECK: not zero
  quantity         Decimal @db.Decimal(12, 3)
  unitPriceExclVat Decimal @map("unit_price_excl_vat") @db.Decimal(12, 2)
  /// 6 or 21 — THE RATE FOR THIS LINE
  vatRate          Decimal @map("vat_rate") @db.Decimal(5, 2)
  /// Set by a DB trigger: round(quantity * unit_price_excl_vat, 2).
  /// Never computed by client JS — that was the NaN-total bug.
  totalExclVat     Decimal @default(0) @map("total_excl_vat") @db.Decimal(12, 2)
  position         Int     @default(0) @db.SmallInt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite FK: the line and its quote MUST belong to the same company.
  quote   Quote    @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
  @@map("quote_lines")
}

/// dueDate is NOT NULL: late is calculated from it, so an invoice without one
/// could never be chased. Pre-filled as issueDate + tenants.defaultPaymentDays.
/// There is NO `overdue` status — see InvoiceStatus.
model Invoice {
  id             Int           @id @default(autoincrement())
  tenantId       Int           @map("tenant_id")
  clientId       Int           @map("client_id")
  projectId      Int           @map("project_id")
  quoteId        Int?          @map("quote_id")
  /// INV-2026-0042
  number         String
  status         InvoiceStatus @default(draft)
  issueDate      DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  defaultVatRate Decimal       @map("default_vat_rate") @db.Decimal(5, 2)
  amountExclVat  Decimal       @default(0) @map("amount_excl_vat") @db.Decimal(12, 2)
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  amountInclVat  Decimal       @default(0) @map("amount_incl_vat") @db.Decimal(12, 2)
  note           String?
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(6)
  reminderCount  Int           @default(0) @map("reminder_count") @db.SmallInt
  lastReminderAt DateTime?     @map("last_reminder_at") @db.Timestamptz(6)
  createdBy      Int?          @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  quote    Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  creator  User?         @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([projectId])
  @@index([tenantId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id               Int     @id @default(autoincrement())
  tenantId         Int     @map("tenant_id")
  invoiceId        Int     @map("invoice_id")
  serviceId        Int?    @map("service_id")
  description      String
  unit             String?
  quantity         Decimal @db.Decimal(12, 3)
  unitPriceExclVat Decimal @map("unit_price_excl_vat") @db.Decimal(12, 2)
  /// THE RATE FOR THIS LINE
  vatRate          Decimal @map("vat_rate") @db.Decimal(5, 2)
  /// Set by a DB trigger: round(quantity * unit_price_excl_vat, 2).
  /// Never computed by client JS — that was the NaN-total bug.
  totalExclVat     Decimal @default(0) @map("total_excl_vat") @db.Decimal(12, 2)
  position         Int     @default(0) @db.SmallInt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Composite FK: the line and its invoice MUST belong to the same company.
  invoice Invoice  @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

/// The ledger. One row per payment received, never a running total.
/// invoice_balance reads the STORED amountInclVat minus SUM(payments).
model Payment {
  id          Int           @id @default(autoincrement())
  tenantId    Int           @map("tenant_id")
  invoiceId   Int           @map("invoice_id")
  /// CHECK: > 0
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  paymentDate DateTime      @default(dbgenerated("CURRENT_DATE")) @map("payment_date") @db.Date
  createdBy   Int?          @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("payments")
}

// ============================================================================
// 7. PURCHASES — MONEY OUT
// ============================================================================

/// The directory — created once, reused on every project.
model Subcontractor {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  companyName String   @map("company_name")
  trade       String?
  email       String?
  phone       String?
  vatNumber   String?  @map("vat_number")
  hourlyRate  Decimal? @map("hourly_rate") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts SubcontractorContract[]

  @@index([tenantId])
  @@map("subcontractors")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String
  email     String?
  phone     String?
  address   String?
  vatNumber String?  @map("vat_number")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]

  @@map("suppliers")
}

/// One engagement per project. projectId is REQUIRED — no contract without a
/// project. Purely internal: never shown to the client.
/// One contract can produce several bills (progress payment, final payment).
model SubcontractorContract {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  subcontractorId Int            @map("subcontractor_id")
  projectId       Int            @map("project_id")
  description     String?
  amountExclVat   Decimal        @map("amount_excl_vat") @db.Decimal(12, 2)
  status          ContractStatus @default(in_progress)
  startDate       DateTime?      @map("start_date") @db.Date
  /// CHECK: not before startDate
  endDate         DateTime?      @map("end_date") @db.Date
  createdBy       Int?           @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor     @relation(fields: [subcontractorId], references: [id], onDelete: Restrict)
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator          User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  purchaseInvoices PurchaseInvoice[]

  @@index([projectId])
  @@map("subcontractor_contracts")
}

/// tenantId is NULLABLE: NULL = a shared default, seeded (material,
/// subcontractor, labor). A tenant admin may add its own rows — insurance,
/// machine rental. The margin groups bills by costTypeId, so a new kind shows
/// up with no column, no migration and no developer.
/// Read with: WHERE tenant_id IS NULL OR tenant_id = :current
model CostType {
  id        Int      @id @default(autoincrement())
  tenantId  Int?     @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]
  snapshotCosts    ProjectClosureSnapshotCost[]

  @@map("cost_types")
}

/// EVERY bill the company receives, both kinds.
///   `type`       = WHO sent us the paper
///   `costTypeId` = WHAT KIND of cost it is — the margin reads this one
///
/// CHECKs:
///   exactly one source: subcontractor -> contract set, supplier NULL
///                       supplier      -> supplier set, contract NULL
///   type = subcontractor -> projectId NOT NULL
/// TRIGGER trg_material_bill_no_project:
///   costType.name = 'material' -> projectId MUST be NULL, because material
///   cost already enters the margin through the stock ledger. Otherwise the
///   same tiles would be counted twice.
///
/// A bill counts in the margin from the day it is ENTERED, whatever its
/// status. `status` only tracks whether the money has left the bank.
/// Instalments: one bill per stage. There is no payment ledger for money out.
model PurchaseInvoice {
  id                      Int                   @id @default(autoincrement())
  tenantId                Int                   @map("tenant_id")
  type                    PurchaseInvoiceType
  costTypeId              Int                   @map("cost_type_id")
  subcontractorContractId Int?                  @map("subcontractor_contract_id")
  supplierId              Int?                  @map("supplier_id")
  projectId               Int?                  @map("project_id")
  /// Our number: PUR-2026-0007
  number                  String
  /// Their invoice number, as printed on their paper.
  externalNumber          String?               @map("external_number")
  amountExclVat           Decimal               @map("amount_excl_vat") @db.Decimal(12, 2)
  vatRate                 Decimal               @default(21.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount               Decimal               @default(0) @map("vat_amount") @db.Decimal(12, 2)
  amountInclVat           Decimal               @default(0) @map("amount_incl_vat") @db.Decimal(12, 2)
  issueDate               DateTime              @map("issue_date") @db.Date
  dueDate                 DateTime?             @map("due_date") @db.Date
  status                  PurchaseInvoiceStatus @default(to_pay)
  paymentReference        String?               @map("payment_reference")
  paidAt                  DateTime?             @map("paid_at") @db.Timestamptz(6)
  createdBy               Int?                  @map("created_by")
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  costType       CostType               @relation(fields: [costTypeId], references: [id], onDelete: Restrict)
  contract       SubcontractorContract? @relation(fields: [subcontractorContractId], references: [id], onDelete: Restrict)
  supplier       Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator        User?                  @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]

  @@unique([tenantId, number])
  @@index([projectId])
  @@map("purchase_invoices")
}

// ============================================================================
// 8. MARGIN
// ============================================================================

/// Written once when a project closes. VOIDED on an admin reopen, never
/// deleted — a snapshot is a financial record. A partial unique index keeps
/// exactly one live row (voidedAt IS NULL) per project.
model ProjectClosureSnapshot {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  projectId     Int       @map("project_id")
  budgetExclVat Decimal   @map("budget_excl_vat") @db.Decimal(12, 2)
  totalCost     Decimal   @map("total_cost") @db.Decimal(12, 2)
  marginExclVat Decimal   @map("margin_excl_vat") @db.Decimal(12, 2)
  marginPct     Decimal?  @map("margin_pct") @db.Decimal(5, 2)
  closedBy      Int?      @map("closed_by")
  closedAt      DateTime  @default(now()) @map("closed_at") @db.Timestamptz(6)
  voidedAt      DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy      Int?      @map("voided_by")

  tenant  Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  closer  User?                        @relation("SnapshotClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  voider  User?                        @relation("SnapshotVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  costs   ProjectClosureSnapshotCost[]

  @@map("project_closure_snapshots")
}

/// The breakdown as ROWS, not columns. No fixed material_cost / labor_cost
/// columns, because a tenant can add cost types — a new kind needs no migration.
model ProjectClosureSnapshotCost {
  id         Int     @id @default(autoincrement())
  tenantId   Int     @map("tenant_id")
  snapshotId Int     @map("snapshot_id")
  costTypeId Int     @map("cost_type_id")
  amount     Decimal @db.Decimal(12, 2)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  snapshot ProjectClosureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  costType CostType               @relation(fields: [costTypeId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, costTypeId])
  @@map("project_closure_snapshot_costs")
}

/// One row per (project, level) — each alert level fires ONCE.
/// Margin is recomputed after every time entry, consumption and purchase
/// invoice; without this a project at 81% would email on every save.
/// If an extra accepted quote raises the budget and cost drops back under the
/// threshold, DELETE the rows so the levels can fire again.
model ProjectMarginAlert {
  tenantId  Int              @map("tenant_id")
  projectId Int              @map("project_id")
  level     MarginAlertLevel
  firedAt   DateTime         @default(now()) @map("fired_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, level])
  @@map("project_margin_alerts")
}

// ============================================================================
// 9. SHARED — MEDIA, NOTIFICATIONS, PORTAL, CHAT
// ============================================================================

/// Polymorphic: entityType + entityId point at any row, with NO foreign key.
/// isLocked = true means the frozen PDF copy of a SENT quote or invoice. The
/// delete endpoint refuses those rows, so the client's legal copy cannot be
/// deleted like an ordinary photo.
/// SUM(fileSize) per tenant is the storage_gb billing dimension.
model Media {
  id         Int             @id @default(autoincrement())
  tenantId   Int             @map("tenant_id")
  entityType MediaEntityType @map("entity_type")
  entityId   Int             @map("entity_id")
  fileName   String          @map("file_name")
  /// ImageKit URL. Never changes after upload — rename touches fileName only.
  fileUrl    String          @map("file_url")
  fileType   String          @map("file_type")
  /// CHECK: > 0 AND <= 10485760 (10 MB)
  fileSize   BigInt          @map("file_size")
  isLocked   Boolean         @default(false) @map("is_locked")
  uploadedBy Int?            @map("uploaded_by")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader User?  @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([tenantId])
  @@map("media")
}

/// tenantId is NULLABLE and adminUserId exists because some alerts go to
/// ChantierOS platform staff — "new tenant signed up", "payment failed" — who
/// have no users row and belong to no tenant. Same two-nullable-columns
/// pattern as refresh_tokens. A CHECK enforces exactly one recipient.
/// retention_days deletes READ notifications only.
model Notification {
  id          Int      @id @default(autoincrement())
  tenantId    Int?     @map("tenant_id")
  userId      Int?     @map("user_id")
  adminUserId Int?     @map("admin_user_id")
  /// low_stock | late_invoice | margin_warning | ...
  type        String
  payload     Json?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminUserId])
  @@map("notifications")
}

/// The URL itself is the access key. The raw token is NEVER stored — only
/// sha256, so a database leak gives nobody portal access.
/// One ACTIVE link per project (partial unique index): generating a new one
/// deactivates the old. Creation is MANUAL — never automatic on project
/// creation, which would open a client chat for every prospect never won.
/// expiresAt is a COLUMN, not a constant, so per-tenant expiry later is a
/// settings change rather than a migration.
model PortalToken {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  clientId  Int      @map("client_id")
  projectId Int      @map("project_id")
  /// sha256, unique. Lookup is by hash.
  tokenHash String   @unique @map("token_hash")
  isActive  Boolean  @default(true) @map("is_active")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User?            @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  tracking PortalTracking[]

  @@map("portal_tokens")
}

model PortalTracking {
  id            Int             @id @default(autoincrement())
  tenantId      Int             @map("tenant_id")
  portalTokenId Int             @map("portal_token_id")
  eventType     PortalEventType @map("event_type")
  ipAddress     String?         @map("ip_address") @db.Inet
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalToken PortalToken @relation(fields: [portalTokenId], references: [id], onDelete: Cascade)

  @@map("portal_tracking")
}

/// A conversation always belongs to exactly ONE tenant. There is no way for
/// two companies to share one. Support is "one tenant <-> the platform".
/// CHECKs: project_client -> projectId NOT NULL
///         support       -> supportTicketId NOT NULL
/// A partial unique index gives a project at most ONE project_client
/// conversation, so regenerating a portal link reuses it.
/// Archived, never deleted: carries isArchived, never isActive.
model Conversation {
  id              Int              @id @default(autoincrement())
  tenantId        Int              @map("tenant_id")
  type            ConversationType
  projectId       Int?             @map("project_id")
  supportTicketId Int?             @map("support_ticket_id")
  isArchived      Boolean          @default(false) @map("is_archived")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project       Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supportTicket SupportTicket?       @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]

  @@index([tenantId])
  @@map("conversations")
}

/// Exactly one of userId / clientId / adminUserId is set — a CHECK enforces it.
model ConversationMember {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  conversationId Int      @map("conversation_id")
  userId         Int?     @map("user_id")
  clientId       Int?     @map("client_id")
  adminUserId    Int?     @map("admin_user_id")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  adminUser    AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@map("conversation_members")
}

/// There is NO attachments column. Every attachment is a Media row with
/// entityType = message and entityId = messages.id. One mechanism for files.
model Message {
  id             Int        @id @default(autoincrement())
  /// Denormalised on purpose: makes tenant-scoped filtering one indexed column.
  tenantId       Int        @map("tenant_id")
  conversationId Int        @map("conversation_id")
  senderType     SenderType @map("sender_type")
  /// users.id | clients.id | admin_users.id, per senderType.
  senderId       Int        @map("sender_id")
  content        String
  isArchived     Boolean    @default(false) @map("is_archived")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// One row per message per reader, written the first time they open the
/// conversation. Exactly one of userId / clientId — a CHECK enforces it,
/// because one row cannot have two readers.
/// Unread count = messages with no matching row for that reader.
model MessageRead {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  messageId Int      @map("message_id")
  userId    Int?     @map("user_id")
  /// The client in the portal, who has no user account.
  clientId  Int?     @map("client_id")
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, clientId])
  @@map("message_reads")
}
